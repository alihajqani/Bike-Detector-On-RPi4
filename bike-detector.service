[Unit]
Description=Bike Detector Docker Compose
Requires=docker.service
After=network.target docker.service systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/Bike-Detector-On-RPi4

ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

TimeoutStartSec=0

[Install]
WantedBy=multi-user.target